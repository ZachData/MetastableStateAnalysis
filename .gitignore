# Deny-by-default: only file types this project deliberately tracks are
# un-ignored below. Kept as a whitelist because run artifacts (npz, png, large
# json) are numerous and easy to commit by accident.
#
# Extended for the CI/Popperian work (POPPER_PLAN.md): before this pass the
# whitelist was *.py and *.md only, which silently ignored pyproject.toml,
# requirements/*.txt, .github/workflows/*.yml and claims/*.json -- i.e. every
# file CI and the prediction registry need. `git check-ignore -v <path>` is the
# thing to run when a newly added config file mysteriously will not commit.
*
!*.py
!*.md
!.gitignore
!pytest.ini
!*/

# --- config / CI / declarative records -------------------------------------
# NB: gitignore has no inline comments -- a trailing "# ..." becomes part of
# the pattern and silently stops it matching. Keep these bare.
!*.toml
!*.cfg
!*.ini
!*.yml
!*.yaml
# Page templates the viz builders fill (p1d_cluster_ensemble/viz_page.py); their data is never tracked.
!*/viz/index.html
# Phase 1d's long prompt texts, their provenance and the composed LaTeX (p1d_cluster_ensemble/long_prompts.py). Inputs, not run output.
!p1d_cluster_ensemble/long_prompts/*.txt
!p1d_cluster_ensemble/long_prompts/*.tex
!p1d_cluster_ensemble/long_prompts/provenance.json
# Phase 1e's four new long passages and their provenance (p1e_energy_field/long_prompts_1e.py). Inputs, not run output.
!p1e_energy_field/long_prompts_1e/*.txt
!p1e_energy_field/long_prompts_1e/provenance.json
# C2's numbers table and figures (trackC_writeup/numbers.py): rendered from records, tracked so the draft renders on any checkout.
!trackC_writeup/numbers.json
!trackC_writeup/fig/*.svg
# C2's LaTeX draft (trackC_writeup/to_tex.py, C2p unit 1): converted from the rendered draft, the folder uploaded to Overleaf; the PDFs are numbers.py's figures.
!trackC_writeup/tex/main.tex
!trackC_writeup/tex/refs.bib
!trackC_writeup/tex/fig/*.pdf
# C2's LaTeX source from C2p unit 2 on (Blocked 108 (a)): the user's Overleaf folder, every file in it; and the figures only it uses, drawn by numbers.py paper-figures.
!trackC_writeup/paper/*
!trackC_writeup/paper/fig/*
!trackC_writeup/fig/paper/*.pdf
# paper_check.py's sources for numbers new to paper/: record slots, and literals with their reason.
!trackC_writeup/paper_slots.json
# GPT-2 small's logged LR (C2 unit 3c), read by tools/math_checks/c2_warmup_grid.py W2.
!trackC_writeup/gpt2_small_lr_log.json
# GitHub's activity events for P-A5's registration branch (§3.4's outside timestamp; GitHub keeps them ~90 days). A `repo:` record of numbers.py.
!trackC_writeup/p_a5_push_record.json
# The session-start hook that prints STATE.md (CLAUDE.md, Start). settings.local.json stays ignored.
!.claude/settings.json
!*.sh
!requirements/*.txt
# The research-vm fleet's contract for this repo (infra/prompt.md). Without it a
# booted instance silently falls back to the fleet defaults (py3.12, `.[dev]`).
!infra/rvm.env

# The prediction registry and its adjudication records are the project's
# falsification ledger, not run output -- they are tracked deliberately.
# Scoped to claims/ so this does not un-ignore result json elsewhere.
!claims/*.json
!claims/**/*.json

# run artifacts
results/
metastability_results/

# python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/

# mutmut working copy (pyproject.toml [tool.mutmut])
/mutants/
# The reviewed list of equivalent mutants (tools/mutation_check.py).
!tools/mutation_accepted.json
