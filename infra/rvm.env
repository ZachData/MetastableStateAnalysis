# infra/rvm.env — how the research-vm fleet runs THIS project
# (https://github.com/ZachData/research-vm-infra). Sourced as shell by the
# fleet's bootstrap/wrapper/worker and by `rvm launch`. Unset values take the
# fleet defaults in research-vm-infra/lib/common.sh.

# --- environment -----------------------------------------------------------
# 3.10: the interpreter of the conda `mets` env that produces the HDBSCAN
# partitions, and one of the two CI runs (ci.yml matrix). uv fetches it at
# boot, so a change here costs a download, not an AMI rebuild.
RVM_PYTHON="3.10"

# The heavy tier, then the package itself with --no-deps so the editable
# install cannot re-resolve anything the requirements files already pinned.
# The fleet pre-installs torch from the CPU index on GPU-less boxes (as
# requirements/heavy.txt asks), so this finds torch already satisfied.
# This exact text is part of the env-cache key: editing it forces a rebuild.
RVM_ENV_INSTALL="pip install -r requirements/heavy.txt && pip install -e . --no-deps"

# Everything that defines site-packages. A change to any of these makes the
# next boot build and publish a new venv; otherwise boots restore from S3.
RVM_ENV_FILES="pyproject.toml requirements/base.txt requirements/test.txt requirements/heavy.txt"

# --- what the agent does ---------------------------------------------------
RVM_PROMPT_FILE="infra/prompt.md"
RVM_BRANCH="main"
RVM_CI_GATE=1

# --- sweeps ----------------------------------------------------------------
# No fan-out wired yet. Set when a runner can take {worker_id}.
RVM_WORKER_CMD=""

# --- machines --------------------------------------------------------------
# t4g.small is 2 vCPU / ~1.8 GB usable, no swap. Measured 2026-09-27:
# `./scripts/check.sh` fits (2 min 25 s); `SMOKE_REAL_DEPS=1 pytest -m smoke`
# is OOM-killed at ~1.1 GB RSS and finishes only with 4 GB of swap (24 min).
# Use t4g.large or up for the smoke tier or any forward pass
# (`rvm launch --type ...`).
RVM_INSTANCE_TYPE="t4g.small"
RVM_HARD_CAP_HOURS=4
RVM_WORKER_HOURS=2

# --- shared data caches ----------------------------------------------------
# name:destination pairs, synced down at boot from s3://<bucket>/caches/<name>/.
# data/ is never committed (CLAUDE.md), so run artifacts reach a box this way:
#   rvm cache push mets-data /path/to/data
# then add "mets-data:/home/ubuntu/MetastableStateAnalysis/data" here.
# `huggingface` holds pythia-70m and the two hf-internal-testing tiny models
# the smoke tier loads (pushed 2026-09-27). No 410m checkpoints yet.
RVM_CACHE_PATHS="huggingface:/home/ubuntu/.cache/huggingface"
